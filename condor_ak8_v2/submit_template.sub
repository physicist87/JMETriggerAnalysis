universe = vanilla

executable = run_ntuple.sh

arguments = $(jobid) $(inputfile) $(OUTPUTDIR)

output = $(LOGDIR)/out/job_$(jobid).out
error  = $(LOGDIR)/err/job_$(jobid).err
log    = $(LOGDIR)/log/job_$(jobid).log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

use_x509userproxy = True

x509userproxy = /afs/cern.ch/user/s/sha/private/x509up_cms

request_cpus   = 1
request_memory = 4000 MB
request_disk   = 10 GB

+JobFlavour = "tomorrow"

queue jobid,inputfile from $(QUEUEFILE)
